# Project Settings → API in the Supabase dashboard.
# Put the real values in .env.local at the project root (Next.js does not load .env files from /src).
# Restart `npm run dev` after changing this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by /api/auth to create student and staff logins.
# Never prefix this with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Student signup and login OTP. Server only. Never prefix with NEXT_PUBLIC_.
# Add the same names in Vercel → Project → Settings → Environment Variables.
# SMS: Message Central VerifyNow. The server Base64-encodes the password. Country code defaults to 91.
VERIFYNOW_CUSTOMER_ID=
VERIFYNOW_EMAIL=
VERIFYNOW_PASSWORD=
VERIFYNOW_COUNTRY_CODE=91
# Email: Resend. RESEND_FROM must be an address on a domain verified in Resend.
# Example: Dakshinvedha <noreply@mail.yourdomain.com>
# onboarding@resend.dev only delivers to the Resend account, so leave OTP off until the domain is verified.
RESEND_API_KEY=
RESEND_FROM=
# Optional. Falls back to SUPABASE_SERVICE_ROLE_KEY for signing OTP tickets.
OTP_TICKET_SECRET=
