# Project Settings → API in the Supabase dashboard.
# Put the real values in .env.local at the project root (Next.js does not load .env files from /src).
# Restart `npm run dev` after changing this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by /api/auth to create student and staff logins.
# Never prefix this with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Student signup OTP. Server only. Never prefix with NEXT_PUBLIC_.
# SMS: 2Factor.in dashboard API key. Optional DLT template name after AUTOGEN.
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
# Email: Resend API key and a verified sender, e.g. Dakshinvedha <noreply@your-domain.com>
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=
# Optional. Falls back to SUPABASE_SERVICE_ROLE_KEY for signing OTP tickets.
OTP_TICKET_SECRET=
